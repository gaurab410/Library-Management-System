@model IEnumerable<LibraryManagementSystem.Models.Notification>
@using LibraryManagementSystem.Models

@{
    ViewData["Title"] = "Notification Feed";
    int unreadCount = ViewBag.UnreadCount ?? 0;
    int totalCount = ViewBag.TotalCount ?? 0;
    bool unreadOnly = ViewBag.UnreadOnly ?? false;
    var selectedType = ViewBag.TypeFilter as NotificationType?;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-bell-fill text-warning me-2"></i>Notifications & System Alerts
        </h2>
        <p class="text-muted mb-0">Automated event logs for loan due dates, overdue fines, and reservation queue readiness.</p>
    </div>

    @if (unreadCount > 0)
    {
        <form asp-action="MarkAllRead" method="post" class="d-inline">
            <button type="submit" class="btn btn-outline-secondary btn-sm shadow-sm">
                <i class="bi bi-check2-all me-1"></i> Mark All as Read (@unreadCount)
            </button>
        </form>
    }
</div>

<!-- Filter Toolbar Card -->
<div class="card shadow-sm border-0 mb-4 bg-light">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <!-- Filter: Read / Unread Status -->
            <div class="col-md-4">
                <div class="btn-group w-100" role="group">
                    <a asp-action="Index" asp-route-unreadOnly="false" asp-route-typeFilter="@selectedType" 
                       class="btn btn-sm @(!unreadOnly ? "btn-primary fw-bold" : "btn-outline-secondary")">
                        <i class="bi bi-inbox me-1"></i> All Alerts (@totalCount)
                    </a>
                    <a asp-action="Index" asp-route-unreadOnly="true" asp-route-typeFilter="@selectedType" 
                       class="btn btn-sm @(unreadOnly ? "btn-primary fw-bold" : "btn-outline-secondary")">
                        <i class="bi bi-envelope-exclamation me-1"></i> Unread Only (@unreadCount)
                    </a>
                </div>
            </div>

            <!-- Filter: Type Dropdown -->
            <div class="col-md-6">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-funnel"></i> Type</span>
                    <select name="typeFilter" class="form-select form-select-sm" onchange="this.form.submit()">
                        <option value="">-- All Alert Types --</option>
                        @foreach (NotificationType t in Enum.GetValues(typeof(NotificationType)))
                        {
                            var isSelected = selectedType.HasValue && selectedType.Value == t;
                            <option value="@t" selected="@(isSelected ? "selected" : null)">@t</option>
                        }
                    </select>
                    <input type="hidden" name="unreadOnly" value="@unreadOnly.ToString().ToLower()" />
                </div>
            </div>

            <!-- Reset Button -->
            <div class="col-md-2 text-md-end">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Notification Feed List -->
@if (!Model.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
            <i class="bi bi-bell-slash text-muted display-4 mb-3 d-block"></i>
            <h5 class="text-muted mb-1">No notifications found</h5>
            <p class="text-secondary small mb-0">There are no notifications matching your current filter criteria.</p>
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var notif in Model)
        {
            var isUnread = !notif.IsRead;

            <div class="card shadow-sm border-0 @(isUnread ? "border-start border-4 border-warning bg-white" : "bg-light bg-opacity-75")">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-start justify-content-between gap-3">
                        <!-- Left Icon + Content -->
                        <div class="d-flex align-items-start gap-3 flex-grow-1">
                            <!-- Type Icon -->
                            <div class="mt-1">
                                @switch (notif.Type)
                                {
                                    case NotificationType.Overdue:
                                        <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-2 fs-4 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                                            <i class="bi bi-exclamation-triangle-fill"></i>
                                        </div>
                                        break;

                                    case NotificationType.DueSoon:
                                        <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 fs-4 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                                            <i class="bi bi-clock-history"></i>
                                        </div>
                                        break;

                                    case NotificationType.FineIssued:
                                        <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-2 fs-4 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                                            <i class="bi bi-cash-coin"></i>
                                        </div>
                                        break;

                                    case NotificationType.ReservationReady:
                                        <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 fs-4 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                                            <i class="bi bi-bookmark-check-fill"></i>
                                        </div>
                                        break;

                                    default:
                                        <div class="rounded-circle bg-info bg-opacity-10 text-info p-2 fs-4 d-flex align-items-center justify-content-center" style="width: 46px; height: 46px;">
                                            <i class="bi bi-info-circle-fill"></i>
                                        </div>
                                        break;
                                }
                            </div>

                            <!-- Notification Message Body -->
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                    <!-- Type Badge -->
                                    @switch (notif.Type)
                                    {
                                        case NotificationType.Overdue:
                                            <span class="badge bg-danger">Overdue Notice</span>
                                            break;
                                        case NotificationType.DueSoon:
                                            <span class="badge bg-warning text-dark">Due Soon</span>
                                            break;
                                        case NotificationType.FineIssued:
                                            <span class="badge bg-danger">Fine Issued</span>
                                            break;
                                        case NotificationType.ReservationReady:
                                            <span class="badge bg-success">Hold Ready for Pickup</span>
                                            break;
                                        default:
                                            <span class="badge bg-info text-dark">@notif.Type</span>
                                            break;
                                    }

                                    @if (isUnread)
                                    {
                                        <span class="badge bg-primary">NEW</span>
                                    }

                                    <span class="text-muted small">
                                        <i class="bi bi-clock me-1"></i>@notif.CreatedAt.ToString("MMM dd, yyyy &bull; hh:mm tt")
                                    </span>
                                </div>

                                <!-- Main Message -->
                                <p class="fs-6 mb-2 fw-semibold @(isUnread ? "text-dark" : "text-secondary")">
                                    @notif.Message
                                </p>

                                <!-- Patron & Item Metadata Pills -->
                                <div class="d-flex align-items-center gap-2 flex-wrap small text-muted">
                                    <span>
                                        <i class="bi bi-person me-1"></i> Patron: <strong>@notif.Borrower.FullName</strong> (@notif.Borrower.CardNumber)
                                    </span>
                                    @if (notif.LibraryItem != null)
                                    {
                                        <span>&bull;</span>
                                        <span>
                                            <i class="bi bi-book me-1"></i> Item: <strong>@notif.LibraryItem.Name</strong> (@notif.LibraryItem.LibraryCode)
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Right Actions -->
                        <div class="text-end flex-shrink-0">
                            @if (isUnread)
                            {
                                <form asp-action="MarkRead" asp-route-id="@notif.NotificationId" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="Mark as read">
                                        <i class="bi bi-check2"></i> Mark Read
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted border py-2 px-3 small">
                                    <i class="bi bi-check2-circle text-success me-1"></i> Read
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
