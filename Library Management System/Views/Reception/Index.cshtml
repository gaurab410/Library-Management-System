@model IEnumerable<LibraryManagementSystem.Models.BorrowTransaction>
@{
    ViewData["Title"] = "Reception Desk - Active Checkouts";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold text-dark mb-0"><i class="bi bi-person-workspace text-success me-2"></i>Reception Desk Portal</h2>
        <p class="text-muted mb-0">Borrow library items, process returns, compute late fines, and manage borrowers.</p>
    </div>
    <div class="btn-group">
        <a asp-action="Borrow" class="btn btn-success fw-bold me-2"><i class="bi bi-box-arrow-up-right me-1"></i> Borrow Item</a>
        <a asp-action="Borrowers" class="btn btn-outline-dark fw-bold"><i class="bi bi-people me-1"></i> Manage Borrowers</a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Search active loans by item code, title, borrower card or name..." value="@ViewBag.Search">
                <button type="submit" class="btn btn-secondary"><i class="bi bi-filter me-1"></i> Filter Active Loans</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history text-warning me-2"></i>Currently Active Loans</h5>
        <span class="badge bg-primary fs-6">Active Count: @Model.Count()</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Library Code</th>
                        <th>Item Title</th>
                        <th>Borrower</th>
                        <th>Borrow Date</th>
                        <th>Due Date</th>
                        <th>Status / Overdue</th>
                        <th class="text-end pe-3">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">No active loans found. All borrowed items have been returned!</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var loan in Model)
                        {
                            bool isOverdue = loan.IsOverdue;
                            int daysLate = loan.DaysLate;
                            decimal estFine = daysLate * 1.50m;

                            <tr class="@(isOverdue ? "table-danger" : "")">
                                <td><code>@loan.LibraryItem.LibraryCode</code></td>
                                <td>
                                    <div class="fw-bold">@loan.LibraryItem.Name</div>
                                    <small class="text-muted">@loan.LibraryItem.ItemType</small>
                                </td>
                                <td>
                                    <div class="fw-bold">@loan.Borrower.FullName</div>
                                    <small class="text-muted">Card: <code>@loan.Borrower.CardNumber</code></small>
                                </td>
                                <td>@loan.BorrowDate.ToString("MMM dd, yyyy")</td>
                                <td>@loan.DueDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (isOverdue)
                                    {
                                        <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>@daysLate Days Overdue</span>
                                        <div class="small text-danger fw-bold">Est Fine: $@estFine.ToString("F2")</div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>On Time</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Return" asp-route-id="@loan.Id" class="btn btn-primary btn-sm fw-bold">
                                        <i class="bi bi-box-arrow-in-left me-1"></i> Process Return
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
