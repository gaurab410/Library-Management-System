@model IEnumerable<LibraryManagementSystem.Models.Borrower>
@{
    ViewData["Title"] = "Borrowers Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold text-dark mb-0"><i class="bi bi-people-fill text-primary me-2"></i>Borrower Directory</h2>
        <p class="text-muted mb-0">Register, edit, view history, or manage member accounts.</p>
    </div>
    <a asp-action="CreateBorrower" class="btn btn-primary fw-bold"><i class="bi bi-person-plus-fill me-1"></i> Add New Borrower</a>
</div>

<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Borrowers">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Search by borrower name, card number, or email..." value="@ViewBag.Search">
                <button type="submit" class="btn btn-secondary"><i class="bi bi-search me-1"></i> Search</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Card Number</th>
                        <th>Full Name</th>
                        <th>Contact Info</th>
                        <th>Member Since</th>
                        <th>Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No borrowers found matching criteria.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var b in Model)
                        {
                            int activeCount = b.BorrowTransactions.Count(t => t.ReturnDate == null);

                            <tr class="@(!b.IsActive ? "table-secondary opacity-75" : "")">
                                <td><code>@b.CardNumber</code></td>
                                <td>
                                    <div class="fw-bold">@b.FullName</div>
                                    <small class="text-muted">@b.Address</small>
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope me-1"></i>@(b.Email ?? "N/A")</div>
                                    <small class="text-muted"><i class="bi bi-telephone me-1"></i>@(b.Phone ?? "N/A")</small>
                                </td>
                                <td>@b.MembershipDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if (b.IsActive)
                                    {
                                        <span class="badge bg-success">Active Member</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    @if (activeCount > 0)
                                    {
                                        <span class="badge bg-primary ms-1">@activeCount Active Loan(s)</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="BorrowerDetails" asp-route-id="@b.Id" class="btn btn-outline-info btn-sm me-1"><i class="bi bi-clock-history"></i> History</a>
                                    <a asp-action="EditBorrower" asp-route-id="@b.Id" class="btn btn-outline-primary btn-sm me-1"><i class="bi bi-pencil"></i> Edit</a>
                                    <a asp-action="DeleteBorrower" asp-route-id="@b.Id" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
