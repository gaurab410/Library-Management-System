@model LibraryManagementSystem.Models.Borrower
@{
    ViewData["Title"] = "Delete Borrower";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-danger border-2">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Delete Borrower Confirmation</h4>
            </div>
            <div class="card-body p-4">
                <div class="bg-light p-3 rounded border mb-4">
                    <h5 class="fw-bold mb-1">@Model.FullName</h5>
                    <p class="text-muted small mb-0">Card Number: <code>@Model.CardNumber</code> | Email: @(Model.Email ?? "N/A")</p>
                </div>

                @if (Model.BorrowTransactions.Any())
                {
                    <div class="alert alert-warning p-3 mb-4">
                        <i class="bi bi-shield-exclamation text-dark fs-4 d-block mb-2"></i>
                        <strong>Foreign Key Protection:</strong> This borrower has <strong>@Model.BorrowTransactions.Count historical borrowing transaction(s)</strong>.
                        To prevent database relationship errors, confirming deletion will automatically <strong>Deactivate</strong> this account while preserving historical records.
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-4">
                        This borrower has no historical borrowing records and will be permanently removed.
                    </div>
                }

                <form asp-action="DeleteBorrower" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Borrowers" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
                        <button type="submit" class="btn btn-danger fw-bold"><i class="bi bi-trash me-1"></i> Confirm Delete / Deactivate</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
