@model LibraryManagementSystem.Models.Borrower
@{
    ViewData["Title"] = "Borrower Details & History";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-badge text-info me-2"></i>Borrower Details & Loan History</h4>
                <span class="badge bg-warning text-dark fs-6">Card: @Model.CardNumber</span>
            </div>
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <h3 class="fw-bold text-dark mb-1">@Model.FullName</h3>
                        <p class="text-muted mb-0"><i class="bi bi-geo-alt me-1"></i>@(Model.Address ?? "No address listed")</p>
                    </div>
                    <div class="col-md-4 text-md-end mt-2 mt-md-0">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success fs-6">Active Member</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">Inactive</span>
                        }
                    </div>
                </div>

                <hr />

                <div class="row g-3 mb-4">
                    <div class="col-sm-4">
                        <label class="small text-muted fw-bold">Email Address</label>
                        <div>@(Model.Email ?? "N/A")</div>
                    </div>
                    <div class="col-sm-4">
                        <label class="small text-muted fw-bold">Phone Number</label>
                        <div>@(Model.Phone ?? "N/A")</div>
                    </div>
                    <div class="col-sm-4">
                        <label class="small text-muted fw-bold">Membership Date</label>
                        <div>@Model.MembershipDate.ToString("MMMM dd, yyyy")</div>
                    </div>
                </div>

                <h5 class="fw-bold text-dark border-top pt-4 mb-3"><i class="bi bi-clock-history text-primary me-2"></i>Complete Borrowing History</h5>

                @if (!Model.BorrowTransactions.Any())
                {
                    <div class="alert alert-light text-center py-3 text-muted">No borrowing transactions recorded for this member.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Item Title</th>
                                    <th>Code</th>
                                    <th>Borrow Date</th>
                                    <th>Due Date</th>
                                    <th>Return Date</th>
                                    <th>Fine Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model.BorrowTransactions.OrderByDescending(t => t.BorrowDate))
                                {
                                    <tr>
                                        <td class="fw-bold">@t.LibraryItem.Name</td>
                                        <td><code>@t.LibraryItem.LibraryCode</code></td>
                                        <td>@t.BorrowDate.ToString("yyyy-MM-dd")</td>
                                        <td>@t.DueDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @if (t.ReturnDate.HasValue)
                                            {
                                                <span class="text-success"><i class="bi bi-check-circle me-1"></i>@t.ReturnDate.Value.ToString("yyyy-MM-dd")</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary">Active Loan</span>
                                            }
                                        </td>
                                        <td>
                                            @if (t.FineAmount > 0)
                                            {
                                                <span class="@(t.IsFinePaid ? "text-success" : "text-danger fw-bold")">
                                                    $@t.FineAmount.ToString("F2") (@(t.IsFinePaid ? "Paid" : "Unpaid"))
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">$0.00</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Borrowers" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Directory</a>
                    <div>
                        <a asp-action="EditBorrower" asp-route-id="@Model.Id" class="btn btn-primary me-2"><i class="bi bi-pencil me-1"></i> Edit Borrower</a>
                        <a asp-action="DeleteBorrower" asp-route-id="@Model.Id" class="btn btn-danger"><i class="bi bi-trash me-1"></i> Delete</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
