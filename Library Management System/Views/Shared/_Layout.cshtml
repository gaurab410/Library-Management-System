<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Management System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Public" asp-action="Index">
                    <i class="bi bi-journal-bookmark-fill text-warning me-2 fs-4"></i> Library System
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain" 
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Public" ? "active fw-bold text-white" : "")" 
                               asp-controller="Public" asp-action="Index">
                                <i class="bi bi-search me-1"></i> Public Search
                            </a>
                        </li>
                        
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active fw-bold text-white" : "")" 
                                   asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock-fill me-1 text-info"></i> Admin Console
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Reception"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reception" ? "active fw-bold text-white" : "")" 
                                   asp-controller="Reception" asp-action="Index">
                                    <i class="bi bi-person-workspace me-1 text-success"></i> Reception Desk
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Manager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Manager" ? "active fw-bold text-white" : "")" 
                                   asp-controller="Manager" asp-action="Index">
                                    <i class="bi bi-bar-chart-line-fill me-1 text-warning"></i> Manager Dashboard
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center ms-auto">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="text-light me-3 small">
                                <i class="bi bi-person-circle text-warning me-1"></i> @User.Identity.Name 
                                <span class="badge bg-secondary ms-1">
                                    @(User.IsInRole("Admin") ? "Admin" : User.IsInRole("Reception") ? "Reception" : User.IsInRole("Manager") ? "Manager" : "User")
                                </span>
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm">
                                    <i class="bi bi-box-arrow-right me-1"></i> Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-warning btn-sm font-weight-bold" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto">
        <div class="container text-center">
            <small>&copy; 2026 - Library Management System | Built with ASP.NET Core MVC</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
