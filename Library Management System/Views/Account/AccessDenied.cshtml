@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center py-5">
    <div class="display-1 text-danger mb-3"><i class="bi bi-shield-slash"></i></div>
    <h2 class="fw-bold">403 - Access Denied</h2>
    <p class="lead text-secondary">You do not have permission to access this portal page with your current account role.</p>
    <div class="mt-4">
        <a asp-controller="Public" asp-action="Index" class="btn btn-primary me-2">
            <i class="bi bi-search me-1"></i> Return to Public Search
        </a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary">
            <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
        </a>
    </div>
</div>
