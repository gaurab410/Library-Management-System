@model LibraryManagementSystem.Models.Branch
@{
    ViewData["Title"] = "Edit Branch";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square text-warning me-2"></i>Edit Branch</h4>
                <span class="badge bg-secondary">ID: #@Model.BranchId</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="BranchId" />
                    <input type="hidden" asp-for="CreatedAt" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <h6 class="fw-bold text-secondary text-uppercase border-bottom pb-2 mb-3">Branch Location & Identity</h6>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                            <textarea asp-for="Address" class="form-control" rows="2" required></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <h6 class="fw-bold text-secondary text-uppercase border-bottom pb-2 mb-3 mt-4">Contact & Operating Hours</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-bold"></label>
                            <input asp-for="Phone" class="form-control" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="OpeningHours" class="form-label fw-bold"></label>
                            <input asp-for="OpeningHours" class="form-control" />
                            <span asp-validation-for="OpeningHours" class="text-danger small"></span>
                        </div>
                        <div class="col-12 mt-3">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                                <label class="form-check-label fw-semibold" asp-for="IsActive">Branch is Active & Accepting Operations</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-success px-4 fw-bold">
                            <i class="bi bi-check-circle me-1"></i> Update Branch
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
