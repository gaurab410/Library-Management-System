@model LibraryManagementSystem.Models.Branch
@{
    ViewData["Title"] = "Branch Details - " + Model.Name;
}

<div class="row justify-content-center">
    <div class="col-md-10 col-lg-9">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold"><i class="bi bi-building text-info me-2"></i>@Model.Name</h4>
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary"><i class="bi bi-dash-circle me-1"></i>Inactive</span>
                    }
                </div>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-uppercase text-secondary mb-3"><i class="bi bi-geo-alt me-1"></i>Location & Hours</h6>
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Address</dt>
                            <dd class="col-sm-8 fw-semibold">@Model.Address</dd>

                            <dt class="col-sm-4 text-muted">Opening Hours</dt>
                            <dd class="col-sm-8">@(Model.OpeningHours ?? "Standard library hours")</dd>

                            <dt class="col-sm-4 text-muted">Registered</dt>
                            <dd class="col-sm-8 text-muted">@Model.CreatedAt.ToString("MMMM dd, yyyy")</dd>
                        </dl>
                    </div>

                    <div class="col-md-6">
                        <h6 class="fw-bold text-uppercase text-secondary mb-3"><i class="bi bi-telephone me-1"></i>Contact Information</h6>
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Phone</dt>
                            <dd class="col-sm-8">@(Model.Phone ?? "Not provided")</dd>

                            <dt class="col-sm-4 text-muted">Email</dt>
                            <dd class="col-sm-8">@(Model.Email ?? "Not provided")</dd>

                            <dt class="col-sm-4 text-muted">Items Held</dt>
                            <dd class="col-sm-8">
                                <span class="badge bg-primary fs-6">@Model.Items.Count items in inventory</span>
                            </dd>
                        </dl>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-box-seam me-2 text-primary"></i>Items Stored at this Branch (@Model.Items.Count)
                    </h5>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-shield-lock me-1"></i> View Full Inventory
                        </a>
                    }
                </div>

                @if (!Model.Items.Any())
                {
                    <div class="alert alert-light border text-center py-4 text-muted">
                        <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                        No items currently assigned to this branch location.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle border">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Type</th>
                                    <th>Item Name</th>
                                    <th>Status</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items.OrderBy(i => i.Name))
                                {
                                    <tr>
                                        <td><code>@item.LibraryCode</code></td>
                                        <td>
                                            @if (item is LibraryManagementSystem.Models.BookItem)
                                            {
                                                <span class="badge bg-primary">Book</span>
                                            }
                                            else if (item is LibraryManagementSystem.Models.MusicItem)
                                            {
                                                <span class="badge bg-info text-dark">Music</span>
                                            }
                                            else if (item is LibraryManagementSystem.Models.ToyItem)
                                            {
                                                <span class="badge bg-warning text-dark">Toy</span>
                                            }
                                        </td>
                                        <td class="fw-semibold">@item.Name</td>
                                        <td>
                                            @switch (item.Status)
                                            {
                                                case LibraryManagementSystem.Models.ItemStatus.Available:
                                                    <span class="badge bg-success">Available</span>
                                                    break;
                                                case LibraryManagementSystem.Models.ItemStatus.Borrowed:
                                                    <span class="badge bg-primary">Borrowed</span>
                                                    break;
                                                case LibraryManagementSystem.Models.ItemStatus.Damaged:
                                                    <span class="badge bg-warning text-dark">Damaged</span>
                                                    break;
                                                case LibraryManagementSystem.Models.ItemStatus.Destroy:
                                                    <span class="badge bg-danger">Destroy</span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Admin" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Branches
                    </a>
                    <div class="d-flex gap-2">
                        <form asp-action="ToggleActive" asp-route-id="@Model.BranchId" method="post" class="d-inline">
                            @if (Model.IsActive)
                            {
                                <button type="submit" class="btn btn-outline-warning" onclick="return confirm('Are you sure you want to deactivate this branch?');">
                                    <i class="bi bi-pause-circle me-1"></i> Deactivate Branch
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-outline-success">
                                    <i class="bi bi-play-circle me-1"></i> Activate Branch
                                </button>
                            }
                        </form>
                        <a asp-action="Edit" asp-route-id="@Model.BranchId" class="btn btn-primary">
                            <i class="bi bi-pencil me-1"></i> Edit Branch
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
