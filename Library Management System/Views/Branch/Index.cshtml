@model IEnumerable<LibraryManagementSystem.Models.Branch>
@{
    ViewData["Title"] = "Branch Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold text-dark mb-0">
            <i class="bi bi-geo-alt-fill text-danger me-2"></i>Library Branches
        </h2>
        <p class="text-muted mb-0">Manage library branch locations, contact details, operating hours, and active statuses.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add New Branch
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" asp-action="Index">
            <div class="row g-2">
                <div class="col-md-8">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Search by branch name, address, email, or phone..." value="@ViewBag.Search">
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-check form-switch pt-2">
                        <input class="form-check-input" type="checkbox" id="activeOnly" name="activeOnly" value="true" checked="@(ViewBag.ActiveOnly == true)" onchange="this.form.submit()">
                        <label class="form-check-label fw-semibold" for="activeOnly">Active branches only</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <button type="submit" class="btn btn-secondary w-100"><i class="bi bi-arrow-right"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Branch Name</th>
                        <th>Address</th>
                        <th>Contact Info</th>
                        <th>Opening Hours</th>
                        <th class="text-center">Inventory</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-3">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-building-exclamation fs-1 d-block mb-2 text-secondary"></i>
                                No branches found matching your search.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var branch in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold fs-6 text-dark">
                                        <i class="bi bi-building me-1 text-primary"></i>@branch.Name
                                    </div>
                                    <small class="text-muted">Established: @branch.CreatedAt.ToString("MMM yyyy")</small>
                                </td>
                                <td>
                                    <span class="small"><i class="bi bi-geo-alt text-danger me-1"></i>@branch.Address</span>
                                </td>
                                <td>
                                    <div class="small">
                                        @if (!string.IsNullOrEmpty(branch.Phone))
                                        {
                                            <div><i class="bi bi-telephone text-muted me-1"></i>@branch.Phone</div>
                                        }
                                        @if (!string.IsNullOrEmpty(branch.Email))
                                        {
                                            <div><i class="bi bi-envelope text-muted me-1"></i>@branch.Email</div>
                                        }
                                        @if (string.IsNullOrEmpty(branch.Phone) && string.IsNullOrEmpty(branch.Email))
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <span class="small text-muted">
                                        <i class="bi bi-clock me-1"></i>@(branch.OpeningHours ?? "Standard library hours")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-box-seam me-1"></i>@branch.Items.Count items
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (branch.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle-fill me-1"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-dash-circle-fill me-1"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@branch.BranchId" class="btn btn-outline-primary" title="Edit Branch">
                                            <i class="bi bi-pencil"></i> Edit
                                        </a>
                                        <a asp-action="Details" asp-route-id="@branch.BranchId" class="btn btn-outline-info" title="View Details">
                                            <i class="bi bi-eye"></i> Details
                                        </a>
                                        <form asp-action="ToggleActive" asp-route-id="@branch.BranchId" method="post" class="d-inline">
                                            @if (branch.IsActive)
                                            {
                                                <button type="submit" class="btn btn-outline-warning btn-sm" title="Deactivate Branch" onclick="return confirm('Are you sure you want to deactivate this branch?');">
                                                    <i class="bi bi-pause-circle"></i> Deactivate
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-success btn-sm" title="Activate Branch">
                                                    <i class="bi bi-play-circle"></i> Activate
                                                </button>
                                            }
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
