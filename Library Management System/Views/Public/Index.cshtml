@model LibraryManagementSystem.Models.PublicSearchViewModel
@{
    ViewData["Title"] = "Public Library Search";
}

<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-book-half text-primary me-2"></i>Library Collection Search
        </h2>
        <p class="text-muted mb-0">Search our books, music albums, and toys from any mobile phone or desktop device.</p>
    </div>
    <div class="col-md-4 text-md-end mt-2 mt-md-0">
        <span class="badge bg-secondary fs-6">Total Items Found: @Model.Results.Count</span>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4 bg-white">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index">
            <div class="row g-3">
                <div class="col-md-5 col-lg-6">
                    <label class="form-label fw-bold small text-uppercase text-secondary">Search Keyword</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control" placeholder="Search by title, author, artist, code..." value="@Model.SearchTerm">
                    </div>
                </div>
                <div class="col-6 col-md-3 col-lg-3">
                    <label class="form-label fw-bold small text-uppercase text-secondary">Item Type</label>
                    <select name="itemType" class="form-select" onchange="this.form.submit()">
                        <option value="All" selected="@(Model.SelectedItemType == "All")">All Categories</option>
                        <option value="Book" selected="@(Model.SelectedItemType == "Book")">Books</option>
                        <option value="Music" selected="@(Model.SelectedItemType == "Music")">Music Albums</option>
                        <option value="Toy" selected="@(Model.SelectedItemType == "Toy")">Toys & Games</option>
                    </select>
                </div>
                <div class="col-6 col-md-4 col-lg-3">
                    <label class="form-label fw-bold small text-uppercase text-secondary">Availability</label>
                    <select name="availability" class="form-select" onchange="this.form.submit()">
                        <option value="All" selected="@(Model.SelectedAvailability == "All")">All Statuses</option>
                        <option value="Available" selected="@(Model.SelectedAvailability == "Available")">Available Only</option>
                        <option value="Borrowed" selected="@(Model.SelectedAvailability == "Borrowed")">Borrowed</option>
                    </select>
                </div>
            </div>
            <div class="d-flex justify-content-end mt-3">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2"><i class="bi bi-arrow-counterclockwise"></i> Reset</a>
                <button type="submit" class="btn btn-primary btn-sm px-4 fw-bold"><i class="bi bi-filter me-1"></i> Apply Filter</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Results.Any())
{
    <div class="alert alert-info text-center py-5 shadow-sm">
        <i class="bi bi-inbox fs-1 d-block mb-2 text-primary"></i>
        <h5>No library items match your search criteria.</h5>
        <p class="mb-0 text-muted">Try clearing search filters or entering a different search term.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.Results)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center pt-3 border-0">
                        <span class="badge bg-dark text-uppercase"><i class="bi bi-upc-scan me-1"></i>@item.LibraryCode</span>
                        @switch (item.Status)
                        {
                            case LibraryManagementSystem.Models.ItemStatus.Available:
                                <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Available</span>
                                break;
                            case LibraryManagementSystem.Models.ItemStatus.Borrowed:
                                <span class="badge bg-primary"><i class="bi bi-clock-history me-1"></i>Borrowed</span>
                                break;
                            case LibraryManagementSystem.Models.ItemStatus.Damaged:
                                <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle me-1"></i>Damaged</span>
                                break;
                            case LibraryManagementSystem.Models.ItemStatus.Destroy:
                                <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Destroyed</span>
                                break;
                        }
                    </div>

                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            @if (item is LibraryManagementSystem.Models.BookItem)
                            {
                                <div class="bg-primary text-white rounded-circle p-2 me-2 d-inline-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                                    <i class="bi bi-book"></i>
                                </div>
                                <span class="text-uppercase fw-bold text-primary small">Book</span>
                            }
                            else if (item is LibraryManagementSystem.Models.MusicItem)
                            {
                                <div class="bg-info text-white rounded-circle p-2 me-2 d-inline-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                                    <i class="bi bi-music-note-beamed"></i>
                                </div>
                                <span class="text-uppercase fw-bold text-info small">Music</span>
                            }
                            else if (item is LibraryManagementSystem.Models.ToyItem)
                            {
                                <div class="bg-warning text-dark rounded-circle p-2 me-2 d-inline-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                                    <i class="bi bi-controller"></i>
                                </div>
                                <span class="text-uppercase fw-bold text-warning small">Toy / Game</span>
                            }
                        </div>

                        <h5 class="card-title fw-bold text-dark mb-2">@item.Name</h5>
                        <p class="card-text text-secondary small line-clamp-2">@item.Description</p>

                        <div class="p-2 bg-light rounded small mt-3">
                            @if (item is LibraryManagementSystem.Models.BookItem book)
                            {
                                <div><strong>Author:</strong> @book.Author</div>
                                <div><strong>Genre:</strong> <span class="badge bg-outline-secondary text-dark border">@book.Genre</span></div>
                                @if (!string.IsNullOrEmpty(book.ISBN))
                                {
                                    <div class="text-muted"><small>ISBN: @book.ISBN</small></div>
                                }
                            }
                            else if (item is LibraryManagementSystem.Models.MusicItem music)
                            {
                                <div><strong>Artist:</strong> @music.Artist</div>
                                <div><strong>Album:</strong> @(music.Album ?? "N/A") (@music.ReleaseYear)</div>
                                @if (!string.IsNullOrEmpty(music.Format))
                                {
                                    <div><strong>Format:</strong> <span class="badge bg-secondary">@music.Format</span></div>
                                }
                            }
                            else if (item is LibraryManagementSystem.Models.ToyItem toy)
                            {
                                <div><strong>Type:</strong> @(toy.ToyType ?? "N/A")</div>
                                <div><strong>Age Group:</strong> @(toy.TargetAgeGroup ?? "All Ages")</div>
                                @if (!string.IsNullOrEmpty(toy.Manufacturer))
                                {
                                    <div class="text-muted"><small>Maker: @toy.Manufacturer</small></div>
                                }
                            }
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top-0 pb-3 pt-0">
                        @if (User.IsInRole("Reception") && item.Status == LibraryManagementSystem.Models.ItemStatus.Available)
                        {
                            <a asp-controller="Reception" asp-action="Borrow" asp-route-libraryItemId="@item.Id" class="btn btn-outline-success btn-sm w-100 fw-bold">
                                <i class="bi bi-arrow-right-circle me-1"></i> Reception Borrow
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
