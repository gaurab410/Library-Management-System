@model LibraryManagementSystem.Models.ItemFormViewModel
@{
    ViewData["Title"] = "Create Music Item";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-dark py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-music-note-beamed me-2"></i>Add New Music Item</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateMusic" method="post">
                    <input type="hidden" asp-for="ItemType" value="Music" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <h6 class="fw-bold text-secondary text-uppercase border-bottom pb-2 mb-3">Common Item Details</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LibraryCode" class="form-label fw-bold"></label>
                            <input asp-for="LibraryCode" class="form-control" placeholder="e.g. MU-2005" required />
                            <span asp-validation-for="LibraryCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-bold"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LibraryManagementSystem.Models.ItemStatus>()"></select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Track or Album Title" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Album overview or tracklist..."></textarea>
                        </div>
                    </div>

                    <h6 class="fw-bold text-secondary text-uppercase border-bottom pb-2 mb-3 mt-4">Music Specific Information</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Artist" class="form-label fw-bold"></label>
                            <input asp-for="Artist" class="form-control" placeholder="Artist or Band name" required />
                            <span asp-validation-for="Artist" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Album" class="form-label fw-bold"></label>
                            <input asp-for="Album" class="form-control" placeholder="Album title" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ReleaseYear" class="form-label fw-bold"></label>
                            <input asp-for="ReleaseYear" class="form-control" type="number" />
                            <span asp-validation-for="ReleaseYear" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Format" class="form-label fw-bold"></label>
                            <select asp-for="Format" class="form-select">
                                <option value="CD">CD</option>
                                <option value="Vinyl">Vinyl</option>
                                <option value="Cassette">Cassette</option>
                                <option value="Digital">Digital</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
                        <button type="submit" class="btn btn-info px-4 fw-bold text-dark"><i class="bi bi-check-circle me-1"></i> Save Music Item</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
