@model LibraryManagementSystem.Models.ItemFormViewModel
@{
    ViewData["Title"] = "Edit Library Item";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square text-warning me-2"></i>Edit @Model.ItemType Item</h4>
                <span class="badge bg-secondary">@Model.LibraryCode</span>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ItemType" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <h6 class="fw-bold text-secondary text-uppercase border-bottom pb-2 mb-3">Common Item Details</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LibraryCode" class="form-label fw-bold"></label>
                            <input asp-for="LibraryCode" class="form-control" required />
                            <span asp-validation-for="LibraryCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-bold"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LibraryManagementSystem.Models.ItemStatus>()"></select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                        </div>
                    </div>

                    @if (Model.ItemType == "Book")
                    {
                        <h6 class="fw-bold text-secondary text-uppercase border-bottom pb-2 mb-3 mt-4">Book Specific Information</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Author" class="form-label fw-bold"></label>
                                <input asp-for="Author" class="form-control" required />
                                <span asp-validation-for="Author" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Genre" class="form-label fw-bold"></label>
                                <input asp-for="Genre" class="form-control" required />
                                <span asp-validation-for="Genre" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ISBN" class="form-label fw-bold"></label>
                                <input asp-for="ISBN" class="form-control" />
                            </div>
                        </div>
                    }
                    else if (Model.ItemType == "Music")
                    {
                        <h6 class="fw-bold text-secondary text-uppercase border-bottom pb-2 mb-3 mt-4">Music Specific Information</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Artist" class="form-label fw-bold"></label>
                                <input asp-for="Artist" class="form-control" required />
                                <span asp-validation-for="Artist" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Album" class="form-label fw-bold"></label>
                                <input asp-for="Album" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ReleaseYear" class="form-label fw-bold"></label>
                                <input asp-for="ReleaseYear" class="form-control" type="number" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Format" class="form-label fw-bold"></label>
                                <input asp-for="Format" class="form-control" placeholder="e.g. Vinyl, CD, Digital" />
                            </div>
                        </div>
                    }
                    else if (Model.ItemType == "Toy")
                    {
                        <h6 class="fw-bold text-secondary text-uppercase border-bottom pb-2 mb-3 mt-4">Toy Specific Information</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ToyType" class="form-label fw-bold"></label>
                                <input asp-for="ToyType" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TargetAgeGroup" class="form-label fw-bold"></label>
                                <input asp-for="TargetAgeGroup" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Manufacturer" class="form-label fw-bold"></label>
                                <input asp-for="Manufacturer" class="form-control" />
                            </div>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
                        <button type="submit" class="btn btn-success px-4 fw-bold"><i class="bi bi-check-circle me-1"></i> Update Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
