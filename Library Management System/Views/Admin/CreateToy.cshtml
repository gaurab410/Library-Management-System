@model LibraryManagementSystem.Models.ItemFormViewModel
@{
    ViewData["Title"] = "Create Toy Item";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-controller me-2"></i>Add New Toy or Game Item</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="CreateToy" method="post">
                    <input type="hidden" asp-for="ItemType" value="Toy" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <h6 class="fw-bold text-secondary text-uppercase border-bottom pb-2 mb-3">Common Item Details</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LibraryCode" class="form-label fw-bold"></label>
                            <input asp-for="LibraryCode" class="form-control" placeholder="e.g. TY-3005" required />
                            <span asp-validation-for="LibraryCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label fw-bold"></label>
                            <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LibraryManagementSystem.Models.ItemStatus>()"></select>
                        </div>
                        <div class="col-12">
                            <label asp-for="Name" class="form-label fw-bold"></label>
                            <input asp-for="Name" class="form-control" placeholder="Toy or Game Name" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Item contents or description..."></textarea>
                        </div>
                    </div>

                    <h6 class="fw-bold text-secondary text-uppercase border-bottom pb-2 mb-3 mt-4">Toy Specific Information</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="ToyType" class="form-label fw-bold"></label>
                            <input asp-for="ToyType" class="form-control" placeholder="e.g. Board Game, Puzzle, Action Figure" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="TargetAgeGroup" class="form-label fw-bold"></label>
                            <input asp-for="TargetAgeGroup" class="form-control" placeholder="e.g. 3+, 8+, 12+, All Ages" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Manufacturer" class="form-label fw-bold"></label>
                            <input asp-for="Manufacturer" class="form-control" placeholder="e.g. LEGO, Hasbro, Mattel" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back to List</a>
                        <button type="submit" class="btn btn-warning px-4 fw-bold text-dark"><i class="bi bi-check-circle me-1"></i> Save Toy Item</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
