@model LibraryManagementSystem.Models.LibraryItem
@{
    ViewData["Title"] = "Delete / Destroy Item";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm border-danger border-2">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Delete / Destroy Confirmation</h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>Important Business Rule:</strong> Setting status to <strong>Destroy</strong> preserves the item record in the database to maintain borrowing history while marking it unusable.
                </div>

                <div class="bg-light p-3 rounded border mb-4">
                    <h5 class="fw-bold mb-1">@Model.Name</h5>
                    <p class="text-muted small mb-2">Code: <code>@Model.LibraryCode</code> | Type: <span class="badge bg-secondary">@Model.ItemType</span></p>
                    <p class="mb-0">@Model.Description</p>
                </div>

                @if (Model.BorrowTransactions.Any())
                {
                    <div class="alert alert-info small">
                        <i class="bi bi-clock-history me-1"></i> This item has <strong>@Model.BorrowTransactions.Count</strong> historical borrowing transaction(s). It will be marked as <strong>Destroyed</strong> to protect transaction integrity.
                    </div>
                }

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="markAsDestroyedOnly" id="markAsDestroyedOnly" value="true" checked />
                        <label class="form-check-label fw-bold" for="markAsDestroyedOnly">
                            Mark status as 'Destroy' (Recommended - Preserves borrowing records)
                        </label>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Cancel</a>
                        <button type="submit" class="btn btn-danger fw-bold"><i class="bi bi-trash me-1"></i> Confirm Delete / Destroy</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
